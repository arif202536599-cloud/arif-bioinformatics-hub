# ==============================================================================
# Arif Bioinformatics Research Hub - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in the values to enable external integrations.
# When variables are left empty, the application automatically runs in rich
# "Guest Demo / Offline" mode with local datasets and browser localStorage.
# ==============================================================================

# Optional: Supabase Authentication & Database
# Create a free project at https://supabase.com
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: OpenAI API Key for Live AI Queries
# (Local demo mode provides curated bioinformatic prompt templates and responses)
VITE_OPENAI_API_KEY=

# Optional: Public Hub URL Base (defaults to ./ for GitHub Pages)
VITE_APP_BASE_URL=
